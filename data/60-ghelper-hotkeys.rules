# Passive read access to ASUS Fn / ROG hotkey devices for the logged-in user.
# The devices are never grabbed, so every key keeps its normal function.
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Asus WMI hotkeys", TAG+="uaccess"
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="ASUSTeK Computer Inc. N-KEY Device", TAG+="uaccess"
