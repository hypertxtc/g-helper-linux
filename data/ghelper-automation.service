[Unit]
Description=g-helper-linux AC/battery automation
After=graphical-session.target

[Service]
Type=simple
# Found through PATH so a PREFIX=/usr/local install works without rewriting
# the unit at install time.
ExecStart=/usr/bin/env ghelper-linux --daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
